                    "pic": "/Users/hendrikleper/Library/CloudStorage/OneDrive-HogeschoolGent/KASK/2025-2026/BA1/MEDIA TOOLKITS/interactive physical/max_tutorial_2025/untitled folder/max4patch.gif"
